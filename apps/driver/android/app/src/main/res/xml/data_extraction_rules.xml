<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude device-specific Keystore-backed tokens and caches -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="root" path="app_flutter/secure_storage" />
    </cloud-backup>
    <device-transfer>
        <!-- Seamless device-to-device migration for offline databases and preferences -->
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- Exclude device-specific Keystore-bound keys -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="root" path="app_flutter/secure_storage" />
    </device-transfer>
</data-extraction-rules>
